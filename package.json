{
  "name": "ygo-next",
  "version": "0.6.11",
  "type": "module",
  "description": "遊戯王NEXT - 遊戯王Neuron(公式カードデータベース)のデッキ管理を劇的に改善するChrome拡張機能",
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "dev": "webpack --mode development --watch",
    "deploy": "bash scripts/deploy.sh",
    "build-and-deploy": "webpack --mode production && bash scripts/deploy.sh",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:combine": "vitest run tests/combine",
    "test:parser": "vitest run tests/combine/parser",
    "test:vitest": "vitest run",
    "test:vitest:ui": "vitest --ui",
    "test:components": "vitest run tests/unit/components",
    "test:download-samples": "bash scripts/test/download-sample-html.sh",
    "test:integration": "bash scripts/test/download-sample-html.sh && vitest run",
    "setup:download-forms": "bash scripts/setup/download-search-forms.sh",
    "setup:extract-mappings": "tsx scripts/setup/extract-mappings.ts",
    "setup:all": "pnpm run setup:download-forms && pnpm run setup:extract-mappings",
    "license:generate": "tsx scripts/generate-licenses.ts"
  },
  "packageManager": "pnpm@10.26.2",
  "keywords": [
    "yugioh",
    "deck",
    "chrome-extension"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/chrome": "^0.2.0",
    "@types/dotenv": "^6.1.1",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^22.19.3",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "^2.1.9",
    "@vue/compiler-sfc": "^3.5.26",
    "@vue/test-utils": "^2.4.6",
    "cheerio": "^1.1.2",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^7.1.2",
    "dotenv": "^17.2.3",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^15.11.7",
    "html-webpack-plugin": "^5.6.8",
    "js-yaml": "^4.1.1",
    "playwright": "^1.62.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "vue": "^3.5.26",
    "vue-loader": "^17.4.2",
    "webpack": "^5.104.1",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "axios": "^1.19.0",
    "canvas": "^3.2.0",
    "jsdom": "^27.3.0",
    "linkedom": "^0.18.12",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "sass": "^1.102.0",
    "sass-loader": "^16.0.6",
    "ws": "^8.18.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "canvas",
      "esbuild"
    ]
  }
}
