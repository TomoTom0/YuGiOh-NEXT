{
  "name": "ygo-next",
  "version": "0.7.2",
  "type": "module",
  "description": "遊戯王NEXT - 遊戯王Neuron(公式カードデータベース)のデッキ管理を劇的に改善するChrome拡張機能",
  "scripts": {
    "build": "webpack --mode development",
    "build:prod": "webpack --mode production",
    "watch": "webpack --mode development --watch",
    "sync": "bash scripts/deploy.sh",
    "build-deploy": "webpack --mode development && bash scripts/deploy.sh",
    "build-deploy:prod": "webpack --mode production && bash scripts/deploy.sh",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:combine": "vitest run tests/combine",
    "test:parser": "vitest run tests/combine/parser",
    "test:vitest": "vitest run",
    "test:vitest:ui": "vitest --ui",
    "test:components": "vitest run tests/unit/components",
    "test:download-samples": "bash scripts/test/download-sample-html.sh",
    "test:integration": "bash scripts/test/download-sample-html.sh && vitest run",
    "setup:download-forms": "bash scripts/setup/download-search-forms.sh",
    "setup:extract-mappings": "tsx scripts/setup/extract-mappings.ts",
    "setup:all": "pnpm run setup:download-forms && pnpm run setup:extract-mappings",
    "license:generate": "tsx scripts/generate-licenses.ts"
  },
  "packageManager": "pnpm@10.26.2",
  "keywords": [
    "yugioh",
    "deck",
    "chrome-extension"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/compiler-sfc": "^3.5.45",
    "@vue/devtools-api": "^8.2.1",
    "@vue/test-utils": "^2.5.1",
    "cheerio": "^1.2.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "fake-indexeddb": "^6.2.8",
    "happy-dom": "^21.0.4",
    "html-webpack-plugin": "^5.6.8",
    "jsdom": "^31.0.0",
    "playwright": "^1.65.0",
    "sass-loader": "^17.1.0",
    "smol-toml": "^1.9.1",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.6.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-loader": "^17.4.2",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "axios": "^1.21.1",
    "canvas": "^3.2.3",
    "linkedom": "^0.18.15",
    "pinia": "^4.1.0",
    "qrcode": "^1.5.4",
    "sass": "^1.108.2",
    "ws": "^8.22.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "canvas",
      "esbuild"
    ],
    "overrides": {
      "js-beautify>glob": ">=14.0.2 <15",
      "editorconfig>minimatch": ">=11.0.1 <12"
    }
  }
}
